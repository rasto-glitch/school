{
  "expo": {
    "name": "Scholify",
    "slug": "school-portal",
    "version": "1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/logo.png",
    "ios": {
      "bundleIdentifier": "com.rastoelkurdi.schoolportal",
      "supportsTablet": false,
      "icon": "./assets/logo-ios.png",
      "infoPlist": {
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Your location is used for real-time bus route tracking so parents are notified when the bus is nearby.",
        "NSLocationWhenInUseUsageDescription": "Your location is used for real-time bus route tracking so parents are notified when the bus is nearby.",
        "NSPhotoLibraryUsageDescription": "Scholify accesses your photo library so you can choose images to use as your profile picture, attach photos to chat messages with teachers and parents, and add cover images to posts you publish.",
        "UIBackgroundModes": [
          "location"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-android.png",
        "backgroundColor": "#4F46E5"
      },
      "package": "com.rastoelkurdi.schoolportal",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBVk3f73EcNizizPWCnK6-j6TEDs6GuPhA"
        }
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Scholify to use your location for bus route tracking.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4F46E5"
        }
      ],
      "expo-web-browser"
    ],
    "updates": {
      "url": "https://u.expo.dev/41cd079b-7217-4df8-be77-3cce354e6f3f"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "41cd079b-7217-4df8-be77-3cce354e6f3f"
      }
    },
    "owner": "rastoelkurdi"
  },

  "splash": {
  "image": "./assets/splash-s.png",
  "backgroundColor": "#4F46E5",
  "resizeMode": "contain"
}

}

