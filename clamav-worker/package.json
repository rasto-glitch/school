{
  "name": "clamav-worker",
  "version": "1.0.0",
  "description": "Pulls pending employee_documents rows, scans them with ClamAV, updates scan_status.",
  "main": "dist/worker.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/worker.ts",
    "build": "tsc",
    "start": "node dist/worker.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.0",
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
