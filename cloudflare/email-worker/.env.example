# Cloudflare Email Worker — config reference.
#
# These values do NOT live in a .env file at runtime. Vars go in
# wrangler.toml under [vars]; secrets are uploaded with `wrangler secret put`.
# This file just lists them so a new operator knows what to configure.

# Backend ingest URL (set in wrangler.toml [vars])
INBOUND_URL=https://REPLACE-ME.up.railway.app/api/inbound/email

# Shared secret (uploaded with `npx wrangler secret put INBOUND_EMAIL_SECRET`).
# Must match the same env var in backend/.env on Railway.
INBOUND_EMAIL_SECRET=
