MASTER_PORT=5002
MASTER_SECRET=change_this_to_a_long_random_secret_string_minimum_32_chars

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend API key — used by the Inbox page to send replies as
# support@scholify.krd / onboarding@scholify.krd / etc. Same project that
