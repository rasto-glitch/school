PORT=5000
NODE_ENV=development

# Supabase (get from https://app.supabase.com -> Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_STORAGE_BUCKET=homework-attachments

# JWT
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters
JWT_EXPIRE=7d
BCRYPT_ROUNDS=10

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Google Maps (server-side distance calc)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Inbound email webhook (shared with Cloudflare Email Worker).
# Generate a long random string and set the same value in:
#   cd cloudflare/email-worker && npx wrangler secret put INBOUND_EMAIL_SECRET
INBOUND_EMAIL_SECRET=

# OTPIQ — Iraqi WhatsApp/SMS verification platform (migration 050).
# Get an API key from https://app.otpiq.com -> Project Settings -> API Keys.
# Use sk_dev_… in development (sends route to a fixed dev phone configured
# in the OTPIQ dashboard, never reaches real users) and sk_live_… in prod.
# OTPIQ_PROVIDER: 'whatsapp' = WhatsApp only with email fallback through
# our SMTP (current default). 'whatsapp-sms' would let OTPIQ fall back to
# paid SMS instead of free email — we deliberately do NOT use that.
OTPIQ_API_KEY=
OTPIQ_BASE_URL=https://api.otpiq.com/api
OTPIQ_PROVIDER=whatsapp
# Shared secret OTPIQ HMAC-signs each delivery webhook with. Generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# and paste the same value into the OTPIQ dashboard's webhook config.
OTPIQ_WEBHOOK_SECRET=
# Public URL we tell OTPIQ to POST delivery events to. In prod this is
# the Railway URL; in dev, an ngrok URL pointing at this backend.
OTPIQ_WEBHOOK_URL=

# Staff (employee) QR attendance — HMAC secret that signs the rotating
# reception kiosk token (migration 063). The token embeds the school id +
# 60s time-window; the server re-signs and compares on /staff-attendance/scan.
# Until this is set the feature is inert: the kiosk-token + scan endpoints
# return 503. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STAFF_ATTENDANCE_QR_SECRET=
