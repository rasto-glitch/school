# Copy this file to .env.test and fill in real values.
# .env.test is gitignored — credentials never get committed.

# Full URL including scheme. Use the Vercel URL for the prod app, or
# http://localhost:5173 if you'd rather run Vite locally first.
BASE_URL=https://your-vercel-deployment.vercel.app

# Used by the bootstrap spec when creating the e2e_* test users.
# Full usernames include this prefix, e.g. demo_admin.
TEST_SCHOOL_ABBREVIATION=

# Admin is the only account you set up manually. The bootstrap spec uses
# this admin to create the parent / teacher / supervisor / reception users
# below, then writes their final usernames + passwords into .env.test for you.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Created by the bootstrap spec — leave blank until you run `npm run bootstrap`.
PARENT_USERNAME=
PARENT_PASSWORD=

TEACHER_USERNAME=
TEACHER_PASSWORD=

SUPERVISOR_USERNAME=
SUPERVISOR_PASSWORD=

RECEPTION_USERNAME=
RECEPTION_PASSWORD=

# Created by the bootstrap spec ONLY if the school has the tuition_fees
# (accounting) premium feature on. If not, leave blank — bootstrap will skip.
ACCOUNTANT_USERNAME=
ACCOUNTANT_PASSWORD=
