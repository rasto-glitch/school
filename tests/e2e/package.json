{
  "name": "school-project-e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Playwright end-to-end tests against the deployed (or local) web frontend.",
  "scripts": {
    "bootstrap": "playwright test specs/00-bootstrap.spec.ts",
    "test": "playwright test --grep-invert bootstrap",
    "test:all": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^25.7.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.3"
  }
}
