# Copy this file to .env.test and fill in real values.
# .env.test is gitignored — never commit it.

# Deployment targets (override if needed).
WEB_BASE_URL=https://school-xi-blush.vercel.app
API_BASE_URL=https://school-production-3ccc.up.railway.app

# Day 1 — admin onboards the world. Only credential the user provides up front.
# Format: school abbreviation prefix + underscore + name (e.g. demo_admin).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Day 2+ — created by the day-1 admin tests, written back here automatically
# (so day-2 reads what day-1 wrote, no manual copy-paste). The script appends
# these lines to .env.test as it creates each role's account.
TEACHER_USERNAME=
TEACHER_PASSWORD=
SUPERVISOR_USERNAME=
SUPERVISOR_PASSWORD=
DRIVER_USERNAME=
DRIVER_PASSWORD=
PARENT_USERNAME=
PARENT_PASSWORD=
ACCOUNTANT_USERNAME=
ACCOUNTANT_PASSWORD=

# Path to the bulk-upload XLSX of students. Place the file at e2e/data/students.xlsx
# or override the path here.
STUDENTS_XLSX=./data/students.xlsx
